# =============================================================================
# Spektr — Production Environment (docker-compose.prod.yml)
# =============================================================================
# Copy to .env.prod on the target VM and fill in secrets:
#   cp .env.prod.example .env.prod
#
# Key differences from .env.example:
#   - Service hostnames use container names (qdrant, neo4j, postgres)
#   - Bind hosts are 0.0.0.0 (container-internal; Caddy publishes externally)
#   - Secrets are [REQUIRED] — no defaults for passwords / API keys

# -----------------------------------------------------------------------------
# Embedding provider
# -----------------------------------------------------------------------------
EMBEDDING_PROVIDER=jina
JINA_API_KEY=                           # [REQUIRED] https://jina.ai/embeddings/
JINA_API_URL=https://api.jina.ai

# -----------------------------------------------------------------------------
# Vector store (Qdrant) — internal
# -----------------------------------------------------------------------------
QDRANT_URL=http://qdrant:6333

# -----------------------------------------------------------------------------
# Knowledge graph (Neo4j) — internal
# -----------------------------------------------------------------------------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=                         # [REQUIRED] pick a strong password

# -----------------------------------------------------------------------------
# Postgres (CocoIndex tracking) — internal
# -----------------------------------------------------------------------------
POSTGRES_DB=cocoindex
POSTGRES_USER=cocoindex
POSTGRES_PASSWORD=                      # [REQUIRED] pick a strong password
DATABASE_URL=postgresql://cocoindex:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# -----------------------------------------------------------------------------
# AWS / S3 / SQS (live ingestion)
# -----------------------------------------------------------------------------
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL=
S3_BUCKET=
S3_SQS_QUEUE_URL=

# -----------------------------------------------------------------------------
# LLM
# -----------------------------------------------------------------------------
LLM_API_TYPE=anthropic
LLM_MODEL=claude-sonnet-4-20250514
LLM_API_KEY=                            # [REQUIRED]
LLM_BASE_URL=

# -----------------------------------------------------------------------------
# MCP server (fronted by Traefik on 443)
# -----------------------------------------------------------------------------
MCP_TRANSPORT=http
MCP_HOST=0.0.0.0
MCP_PORT=8080
MCP_API_KEY=                            # [REQUIRED in prod] Bearer token for clients
MCP_PUBLIC_DOMAIN=                      # [REQUIRED in prod] Public domain for Traefik (e.g. mcp.example.com)

# -----------------------------------------------------------------------------
# Live ingest (fronted by its own auth layer)
# -----------------------------------------------------------------------------
LIVE_INGEST_PORT=8000
INGEST_API_KEY=                         # [REQUIRED in prod]

# -----------------------------------------------------------------------------
# Resilience / observability
# -----------------------------------------------------------------------------
PIPELINE_MAX_RETRIES=3
OBSERVABILITY_LOCAL_ONLY=true
LOGFIRE_TOKEN=
