# =============================================================================
# Spektr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before running.
# Variables with a default value can be left as-is for local development.
# Variables marked [OPTIONAL] can stay empty until you need the feature.
#
# Style note, load-bearing: a variable left EMPTY must carry its comment on
# the line above, never inline. Docker Compose's `env_file:` parser only
# strips an inline comment when a value precedes it, so `FOO=  # note` sets
# FOO to the literal string "# note" inside the container. That turns an
# unset AWS_ENDPOINT_URL or S3_PREFIX into a silent misconfiguration.
# Inline comments are fine on lines that do have a value.

# -----------------------------------------------------------------------------
# Embedding Selection
# -----------------------------------------------------------------------------
# Spektr selects embeddings on two orthogonal axes:
#   EMBEDDING_MODEL — which model (capabilities, dimensions)
#   EMBEDDING_ROUTE — which endpoint serves it
# The same model can be reachable more than one way, so these are separate.
#
#   MODEL      | native                | openrouter
#   -----------+-----------------------+---------------------------------
#   jina-v4    | api.jina.ai           | not served there
#   voyage-4   | api.voyageai.com      | voyageai/voyage-4-large
#   gemini-2   | (not supported)       | google/gemini-embedding-2
#
# gemini-2 has no native route on purpose: Google direct returns 429s citing
# Vertex quota, while OpenRouter fronts three endpoints and routes around a
# degraded one. Illegal pairs are rejected at startup.
#
# Capabilities follow the MODEL, not the route:
#   MODEL      | dims (default) | valid sizes           | image | ColBERT | late chunk
#   -----------+----------------+-----------------------+-------+---------+-----------
#   jina-v4    | 2048           | any 1..2048 (MRL)     | yes   | yes     | yes
#   voyage-4   | 1024           | 256/512/1024/2048     | yes*  | no      | no
#   gemini-2   | 3072           | any 1..3072 (MRL)     | yes   | no      | no
#
# EMBEDDING_DIMENSIONS below is ONE knob, validated against the active
# model's valid sizes at startup. It is deliberately not per-model: only one
# model is ever active, so per-model keys would be dead config for the other
# two — and the real risk (a size tuned for one model carrying over to
# another that rejects it) is caught by that validation instead. 768 suits
# gemini-2 but is NOT a voyage-4 size, and switching would now fail loudly.
#   * voyage-4 image embedding is implemented on the NATIVE route only.
#     Settings rejects IMAGE_EMBED_STRATEGY != none when the active pair
#     cannot embed images, so a misconfiguration fails at startup rather
#     than silently dropping pages.
#
# Switching model changes the vector space: recreate the Qdrant collections
# and re-ingest. Switching route alone does not.
EMBEDDING_MODEL=gemini-2                # jina-v4 | voyage-4 | gemini-2
#
# Switching model changes the vector space: recreate the Qdrant collections
# and re-ingest. Switching route alone does not.
#
# ONE-LINE SWITCH: change EMBEDDING_MODEL and leave the two below empty/0.
# Route and dimensions then follow the model automatically — you never
# retune them by hand. Set them only to deliberately override the registry.
# Valid values: native | openrouter   (empty = the model's default, below)
#   jina-v4  -> native      (only route; not served by OpenRouter)
#   voyage-4 -> native      (openrouter also valid; native adds images)
#   gemini-2 -> openrouter  (only route; no native client on purpose)
EMBEDDING_ROUTE=
EMBEDDING_DIMENSIONS=0                  # 0 = the model's recommended size:
                                        # jina-v4 512, voyage-4 1024, gemini-2 768

# -----------------------------------------------------------------------------
# Jina v4 Embeddings (only when EMBEDDING_MODEL=jina-v4)
# -----------------------------------------------------------------------------
# Get your API key at https://jina.ai/embeddings/
# Single model for text + image + ColBERT multi-vector embeddings.
# [REQUIRED if EMBEDDING_MODEL=jina-v4] Jina API key
JINA_API_KEY=
JINA_API_URL=https://api.jina.ai        # Base URL (change for proxy/self-hosted)
JINA_MODEL=jina-embeddings-v4           # Model name
JINA_MAX_CONCURRENT=5                   # Max parallel requests to Jina API
JINA_RPM=500                            # Requests/min (free=500, tier1=500, tier2=5000)
JINA_TPM=100000                         # Tokens/min (free=100k, tier1=10M, tier2=100M)
JINA_BATCH_SIZE=10                      # Max texts per API call. Lower to avoid TPM limits
                                        # on free/tier1 plans (try 5 for long documents).

# -----------------------------------------------------------------------------
# Voyage AI Embeddings (only when EMBEDDING_MODEL=voyage-4)
# -----------------------------------------------------------------------------
# Get your API key at https://dash.voyageai.com/
# Uses two models: one for text, one for multimodal (images).
# ColBERT multi-vector is NOT supported by Voyage.
# [REQUIRED if EMBEDDING_MODEL=voyage-4] Voyage API key
VOYAGE_API_KEY=
VOYAGE_API_URL=https://api.voyageai.com # Base URL
VOYAGE_TEXT_MODEL=voyage-4-large        # Text embedding model
VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5  # Image embedding model
VOYAGE_RPM=300                          # Requests per minute
VOYAGE_MAX_CONCURRENT=10                # Max parallel requests

# -----------------------------------------------------------------------------
# OpenRouter Embeddings (only when EMBEDDING_ROUTE=openrouter)
# -----------------------------------------------------------------------------
# Get your API key at https://openrouter.ai/keys
# OpenAI-compatible /v1/embeddings endpoint. Serves gemini-2 and voyage-4;
# the wire model id is derived from EMBEDDING_MODEL via the registry in
# config/embedding_models.py, NOT configured here.
#
# This is deliberately not a general client for all ~32 models OpenRouter
# lists: the input_type contract below holds for the Gemini and Voyage
# families but not for the e5/bge/sentence-transformers ones, which expect
# instruction prefixes in the text instead.
#
# Documents and queries are embedded asymmetrically via the gateway's
# `input_type` parameter (passage -> "document", query -> "query"). Note
# that Gemini's own `task_type` and Jina's `task` are accepted by the
# gateway and then silently ignored — only `input_type` has any effect.
# Likewise `dimensions` works but Gemini's `output_dimensionality` does not.
#
# IMAGES: supported for gemini-2 on this route. The same model id embeds
# text and images into one space and `dimensions` is honoured for image
# input, so image points share documents_dense with text and a plain text
# query retrieves them. Images bill on a separate meter ($0.45/M).
# ColBERT multi-vector is NOT available here and cannot be — gemini-2 emits
# a single vector — so the `visual_search` tool stays jina-v4/native only.
# [REQUIRED if EMBEDDING_ROUTE=openrouter] OpenRouter API key
OPENROUTER_API_KEY=
OPENROUTER_API_URL=https://openrouter.ai/api
OPENROUTER_BATCH_SIZE=100               # Max inputs per call. Gemini hard-rejects >100
                                        # with a non-retryable 400.
OPENROUTER_RPM=300                      # Requests per minute
OPENROUTER_MAX_CONCURRENT=10            # Max parallel requests
# Optional, sent as HTTP-Referer for openrouter.ai rankings
OPENROUTER_HTTP_REFERER=
# Optional, sent as X-Title for openrouter.ai rankings
OPENROUTER_X_TITLE=

# -----------------------------------------------------------------------------
# Qdrant (Vector Store)
# -----------------------------------------------------------------------------
# Runs locally via docker compose. No API key needed for local dev.
QDRANT_PORT=6333                        # Host port for Qdrant REST API
QDRANT_GRPC_PORT=6334                   # Host port for Qdrant gRPC API
QDRANT_URL=http://localhost:${QDRANT_PORT}
# Collection names. Leave unset in normal use — the test suite overrides these
# to throwaway `test_*` copies so its fixtures can drop and recreate freely
# without touching your ingested corpus.
#QDRANT_DENSE_COLLECTION=documents_dense
#QDRANT_MULTIVEC_COLLECTION=documents_multivec

# -----------------------------------------------------------------------------
# Neo4j (Knowledge Graph)
# -----------------------------------------------------------------------------
# Runs locally via docker compose. Password must match docker-compose.yml.
NEO4J_HTTP_PORT=7474                    # Host port for Neo4j browser
NEO4J_BOLT_PORT=7687                    # Host port for Neo4j Bolt protocol
NEO4J_URI=bolt://localhost:${NEO4J_BOLT_PORT}
NEO4J_USER=neo4j                        # Default Neo4j user
NEO4J_PASSWORD=password                 # [REQUIRED] Must match docker-compose.yml

# -----------------------------------------------------------------------------
# CocoIndex Pipeline State
# -----------------------------------------------------------------------------
# CocoIndex v1 keeps its target-state ledger, memoization cache and component
# tree in a local LMDB directory — no PostgreSQL service is involved. The path
# is a *directory*; it lives under state/ so the ingest_state volume covers it.
COCOINDEX_DB_PATH=state/cocoindex.db    # LMDB state directory
# COCOINDEX_LMDB_MAP_SIZE=4294967296    # Raise if the ledger outgrows 4 GiB

# Model cache. fastembed downloads Qdrant/minicoil-v1 (the sparse channel) on
# first use — during ingestion *and* on the MCP server, which encodes queries
# with it. Pointing HF_HOME under state/ puts the cache on the ingest_state
# volume so containers don't re-download it every recreate. Docker only.
# HF_HOME=/app/state/hf

# -----------------------------------------------------------------------------
# Document Source
# -----------------------------------------------------------------------------
# Where the ingestion pipeline reads files from. Mutually exclusive:
#   "local"      — reads from LOCAL_DOCUMENTS_PATH (default: documents/)
#   "s3"         — reads from S3_BUCKET_NAME; SQS optionally triggers catch-up
#   "sharepoint" — reads from LOCAL_DOCUMENTS_PATH which is populated by the
#                  separate sharepoint-sync service (see SHAREPOINT_* below)
# Settings validation rejects "s3" without S3_BUCKET_NAME, and rejects
# "sharepoint" without all SHAREPOINT_* fields populated.
DOCUMENT_SOURCE=local                   # "local" | "s3" | "sharepoint"
LOCAL_DOCUMENTS_PATH=documents          # Path for local/sharepoint mode

# -----------------------------------------------------------------------------
# AWS (only used when DOCUMENT_SOURCE=s3)
# -----------------------------------------------------------------------------
# Credentials: set explicitly here, or leave empty to use the default
# boto3 credential chain (~/.aws/credentials, IAM role, etc.).
#
# Endpoint URL: set for LocalStack (http://localhost:4566) or other
# S3-compatible services (MinIO, R2, etc.). Leave empty for real AWS.
# AWS access key (or use ~/.aws/credentials)
AWS_ACCESS_KEY_ID=
# AWS secret key
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1                    # AWS region for S3/SQS
# e.g. http://localhost:4566 for LocalStack
AWS_ENDPOINT_URL=
# e.g. my-documents-bucket
S3_BUCKET_NAME=
# optional key prefix to restrict the scan
S3_PREFIX=
# CocoIndex v1 has no built-in S3 push trigger. The queue below is used purely
# as a *trigger*: on an event the daemon debounces, then runs one catch-up
# scan. Nothing is downloaded except objects that actually changed. Leave empty
# to fall back to interval-only sweeps.
# e.g. https://sqs.us-east-1.amazonaws.com/123456789/my-queue
S3_SQS_QUEUE_URL=
S3_SQS_DEBOUNCE_SECONDS=5               # coalesce an event burst into one run
S3_FULL_SCAN_INTERVAL_HOURS=24          # safety net sweep for missed events

# -----------------------------------------------------------------------------
# SharePoint (only used when DOCUMENT_SOURCE=sharepoint)
# -----------------------------------------------------------------------------
# See docs/ingestion/sharepoint-setup.md for the full walkthrough.
# All six fields below are required when DOCUMENT_SOURCE=sharepoint.
# Azure AD directory (tenant) id
SHAREPOINT_TENANT_ID=
# Azure AD app (client) id
SHAREPOINT_CLIENT_ID=
# Client secret value (shown only once on creation)
SHAREPOINT_CLIENT_SECRET=
# e.g. contoso.sharepoint.com,abc-1234,def-5678
SHAREPOINT_SITE_ID=
# The document library's drive id
SHAREPOINT_DRIVE_ID=
# In-scope folder, e.g. /Engineering/Specs
SHAREPOINT_ROOT_FOLDER_PATH=
SHAREPOINT_LOCAL_SUBDIR=sharepoint      # Subdir under LOCAL_DOCUMENTS_PATH
SHAREPOINT_SYNC_INTERVAL_SECONDS=180    # Polling interval
SHAREPOINT_STATE_DIR=state/sharepoint   # Where the delta token + index live

# -----------------------------------------------------------------------------
# LLM (Entity Extraction + Agent)
# -----------------------------------------------------------------------------
# Used for entity extraction during ingestion and by the Pydantic AI agent.
# API type options: anthropic, openai (or any OpenAI-compatible via LLM_BASE_URL)
#
# When LLM_BASE_URL is set, the agent routes through an OpenAI-compatible
# endpoint (OpenRouter, Ollama, vLLM, LiteLLM, etc.). LLM_API_TYPE still
# controls client selection for ingestion/VLM; LLM_MODEL is sent as-is.
LLM_API_TYPE=anthropic                  # "anthropic" or "openai"
LLM_MODEL=claude-haiku-4.5              # Model ID for chosen provider. Drives Graphiti
                                        # entity extraction, which dominates ingest cost —
                                        # one LLM call per episode. Raise deliberately.
# [REQUIRED] API key for the LLM provider
LLM_API_KEY=
# [OPTIONAL] Custom base URL (OpenRouter, Ollama, vLLM, etc.)
LLM_BASE_URL=

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------
# Transport, bind address, port, and URL path for the MCP server that
# exposes search tools to agents.
#
# Transports:
#   http            streamable-http (modern default, recommended). Request/
#                   response per call; clean disconnects; supported by Claude
#                   Code, Claude Desktop, Pydantic AI, and most 2025+ clients.
#   sse             legacy long-lived SSE. Only use if a client requires it.
#                   Emits noisy (but harmless) ClosedResourceError tracebacks
#                   on client disconnect — an upstream FastMCP/MCP-SDK quirk.
#   stdio           subprocess transport; host/port/path are ignored.
MCP_TRANSPORT=http                      # "http" (recommended), "sse", or "stdio"
MCP_HOST=0.0.0.0                        # Bind address; 0.0.0.0 for Docker/LAN, 127.0.0.1 for local-only
MCP_PORT=8080                           # Port for http/sse transports
MCP_PATH=/mcp                           # URL path for http/sse transports (endpoint: http://HOST:PORT+PATH)

# Bearer token auth for MCP tool calls. Leave empty to disable auth.
# [OPTIONAL] Set to secure the MCP server
MCP_API_KEY=
# [PROD ONLY] Public domain for Traefik routing (e.g. mcp.example.com)
MCP_PUBLIC_DOMAIN=

# -----------------------------------------------------------------------------
# Live Ingestion (Path B)
# -----------------------------------------------------------------------------
# INGEST_API_KEY gates /session/start; returns ephemeral per-session token
# for /ingest/transcript and /session/end. Leave empty to disable auth.
# [OPTIONAL] Set to secure live ingest
INGEST_API_KEY=

# -----------------------------------------------------------------------------
# Resilience
# -----------------------------------------------------------------------------
PIPELINE_TIMEOUT=3600                   # Per-file processing timeout in seconds (default 1h)
PIPELINE_MAX_RETRIES=3                  # Failures per file before poison-pill (logs CRITICAL + swallows)
PIPELINE_MAX_CONCURRENT_FILES=4         # Files processed in parallel (CocoIndex max_inflight_components)
GRAPHITI_CONCURRENCY=3                  # Max concurrent Graphiti episode ingestions per page
EXTRACTION_TIMEOUT=30                   # Seconds before LLM extraction times out
TOOL_TIMEOUT=30                         # Seconds before MCP tool calls time out
MAX_RETRIES=3                           # Retry count for transient failures

# -----------------------------------------------------------------------------
# Image Embedding
# -----------------------------------------------------------------------------
# Controls which PDF pages get image-embedded (expensive vision model calls).
#   "smart" — embed a PDF page only when it contains at least one embedded
#             RASTER image, detected with PyMuPDF's fitz_page.get_images().
#             This is not Docling layout analysis: a page whose figure is
#             vector art or a table drawn in lines has no raster image and is
#             therefore NOT image-embedded.
#   "all"   — embed every PDF page (slow, expensive).
#   "none"  — skip image embedding entirely.
# Pure image inputs (.png/.jpg) are always embedded regardless of this setting.
# Settings REJECTS "smart"/"all" when the active EMBEDDING_MODEL x
# EMBEDDING_ROUTE has no image support, so a misconfiguration fails at
# startup instead of silently dropping pages.
IMAGE_EMBED_STRATEGY=none               # "smart" (settings default), "all", or "none".
                                        # Must be "none" for the default gemini-2/openrouter pair.
IMAGE_EMBED_MAX_PX=400                  # Max px on longest side before embedding

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
RERANK_ENABLED=true                     # Rescore fused candidates with RERANK_MODEL.
                                        # jina-reranker-v3.5 is LISTWISE, not a cross-encoder:
                                        # scores are unbounded logits, not [0,1].
                                        # NOTE: hybrid_search's relevance gate compares the top
                                        # score against RERANK_SCORE_FLOOR. With reranking off,
                                        # that score is the RRF fusion score (always > 0), so the
                                        # gate can never fire and the retry never runs.
VLM_GENERATION_ENABLED=false            # Enable vision-language model generation
MULTIVEC_ENABLED=false                  # ColBERT multi-vectors. Requires EMBEDDING_MODEL=jina-v4
                                        # + EMBEDDING_ROUTE=native (v4 emits ColBERT itself; there
                                        # is no separate model). Rejected at startup otherwise.
                                        # Populates the documents_multivec collection used by
                                        # visual_search. Costs ~1000 vectors per page.
GRAPH_ENABLED=true                      # Write a Neo4j knowledge graph during Path A ingestion,
                                        # using whichever engine GRAPH_ENGINE selects.
GRAPH_SEMAPHORE_LIMIT=10                # Concurrent LLM calls in Graphiti (default: 10)
GRAPH_EPISODE_TARGET_SIZE=1500          # Target chars per Graphiti episode (groups small chunks)
GRAPH_ENGINE=graphiti                   # "graphiti" (default; LLM-based temporal episodes, slow,
                                        # costs LLM tokens per document) or "gliner" (local CPU
                                        # extraction, fast and free, needs the `gliner` extra:
                                        # `uv sync --extra gliner`).
                                        # Path A only — Path B always uses Graphiti.

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                         # "json" (structured) or "text" (human-readable)

# Distributed tracing (Logfire / OpenTelemetry). Default is local-only:
# spans emitted in-process but not shipped anywhere. Set LOGFIRE_TOKEN +
# OBSERVABILITY_LOCAL_ONLY=false to ship to Logfire Cloud.
# [OPTIONAL] Logfire Cloud token
LOGFIRE_TOKEN=
OBSERVABILITY_LOCAL_ONLY=true           # "true" = no network egress
SERVICE_NAME=spektr                     # Service name tag on all spans

# =============================================================================
# Production Overrides (docker-compose.prod.yml)
# =============================================================================
# In production, services resolve each other by container name on the internal
# Docker network. Override these in your .env.prod (gitignored):
#
#   QDRANT_URL=http://qdrant:6333
#   NEO4J_URI=bolt://neo4j:7687
#   MCP_API_KEY=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))">
#   MCP_PUBLIC_DOMAIN=mcp.example.com
#   INGEST_API_KEY=<generate similarly>
#
# Use a strong, randomly generated password for NEO4J_PASSWORD.
# See docs/deployment/production.md for the full setup guide.
