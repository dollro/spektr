# =============================================================================
# Spektr — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set before running.
# Variables with a default value can be left as-is for local development.
# Variables marked [OPTIONAL] can stay empty until you need the feature.

# -----------------------------------------------------------------------------
# Embedding Provider
# -----------------------------------------------------------------------------
# Spektr supports multiple embedding providers. Set EMBEDDING_PROVIDER to
# choose which one to use, then configure the corresponding section below.
#
# To switch providers:
#   1. Set EMBEDDING_PROVIDER to "jina", "voyage", or "openrouter"
#   2. Fill in the API key for that provider
#   3. Restart the ingestion pipeline and MCP server
#
# NOTE: Switching providers on an existing deployment means re-ingesting all
# documents, since vectors from different providers are not compatible.
# The Qdrant collections must be recreated with the new dimensions.
EMBEDDING_PROVIDER=jina                 # "jina" (default), "voyage", or "openrouter"

# -----------------------------------------------------------------------------
# Jina v4 Embeddings (only when EMBEDDING_PROVIDER=jina)
# -----------------------------------------------------------------------------
# Get your API key at https://jina.ai/embeddings/
# Single model for text + image + ColBERT multi-vector embeddings.
JINA_API_KEY=                           # [REQUIRED if jina] Jina API key
JINA_API_URL=https://api.jina.ai        # Base URL (change for proxy/self-hosted)
JINA_MODEL=jina-embeddings-v4           # Model name
JINA_DENSE_DIMENSIONS=512               # Dense vector dimensions (Matryoshka: 128/256/512/1024/2048)
JINA_MAX_CONCURRENT=5                   # Max parallel requests to Jina API
JINA_RPM=500                            # Requests/min (free=500, tier1=500, tier2=5000)
JINA_TPM=100000                         # Tokens/min (free=100k, tier1=10M, tier2=100M)
JINA_BATCH_SIZE=10                      # Max texts per API call. Lower to avoid TPM limits
                                        # on free/tier1 plans (try 5 for long documents).

# -----------------------------------------------------------------------------
# Voyage AI Embeddings (only when EMBEDDING_PROVIDER=voyage)
# -----------------------------------------------------------------------------
# Get your API key at https://dash.voyageai.com/
# Uses two models: one for text, one for multimodal (images).
# ColBERT multi-vector is NOT supported by Voyage.
VOYAGE_API_KEY=                         # [REQUIRED if voyage] Voyage API key
VOYAGE_API_URL=https://api.voyageai.com # Base URL
VOYAGE_TEXT_MODEL=voyage-4-large        # Text embedding model
VOYAGE_MULTIMODAL_MODEL=voyage-multimodal-3.5  # Image embedding model
VOYAGE_DENSE_DIMENSIONS=1024            # Output dimensions (256, 512, 1024, 2048)
VOYAGE_RPM=300                          # Requests per minute
VOYAGE_MAX_CONCURRENT=10                # Max parallel requests

# -----------------------------------------------------------------------------
# OpenRouter Embeddings (only when EMBEDDING_PROVIDER=openrouter)
# -----------------------------------------------------------------------------
# Get your API key at https://openrouter.ai/keys
# OpenAI-compatible /v1/embeddings endpoint. Default model is Google
# Gemini Embedding 2 (3072d, MRL truncation, leads MTEB v2 at 68.32).
# Any OpenRouter-served embedding model works — change OPENROUTER_MODEL.
# TEXT-ONLY: image embedding raises NotImplementedError. Set
# IMAGE_EMBED_STRATEGY=none for text-only corpora, or use jina/voyage
# if your pipeline needs PDF page or image embeddings.
OPENROUTER_API_KEY=                     # [REQUIRED if openrouter] OpenRouter API key
OPENROUTER_API_URL=https://openrouter.ai/api
OPENROUTER_MODEL=google/gemini-embedding-2-preview
OPENROUTER_DENSE_DIMENSIONS=3072        # Default for Gemini Embedding 2 (MRL: 768/1536/3072)
OPENROUTER_RPM=300                      # Requests per minute
OPENROUTER_MAX_CONCURRENT=10            # Max parallel requests
OPENROUTER_HTTP_REFERER=                # Optional, sent as HTTP-Referer for openrouter.ai rankings
OPENROUTER_X_TITLE=                     # Optional, sent as X-Title for openrouter.ai rankings

# -----------------------------------------------------------------------------
# Qdrant (Vector Store)
# -----------------------------------------------------------------------------
# Runs locally via docker compose. No API key needed for local dev.
QDRANT_PORT=6333                        # Host port for Qdrant REST API
QDRANT_GRPC_PORT=6334                   # Host port for Qdrant gRPC API
QDRANT_URL=http://localhost:${QDRANT_PORT}
# Collection names. Leave unset in normal use — the test suite overrides these
# to throwaway `test_*` copies so its fixtures can drop and recreate freely
# without touching your ingested corpus.
#QDRANT_DENSE_COLLECTION=documents_dense
#QDRANT_MULTIVEC_COLLECTION=documents_multivec

# -----------------------------------------------------------------------------
# Neo4j (Knowledge Graph)
# -----------------------------------------------------------------------------
# Runs locally via docker compose. Password must match docker-compose.yml.
NEO4J_HTTP_PORT=7474                    # Host port for Neo4j browser
NEO4J_BOLT_PORT=7687                    # Host port for Neo4j Bolt protocol
NEO4J_URI=bolt://localhost:${NEO4J_BOLT_PORT}
NEO4J_USER=neo4j                        # Default Neo4j user
NEO4J_PASSWORD=password                 # [REQUIRED] Must match docker-compose.yml

# -----------------------------------------------------------------------------
# CocoIndex Pipeline State
# -----------------------------------------------------------------------------
# CocoIndex v1 keeps its target-state ledger, memoization cache and component
# tree in a local LMDB directory — no PostgreSQL service is involved. The path
# is a *directory*; it lives under state/ so the ingest_state volume covers it.
COCOINDEX_DB_PATH=state/cocoindex.db    # LMDB state directory
# COCOINDEX_LMDB_MAP_SIZE=4294967296    # Raise if the ledger outgrows 4 GiB

# -----------------------------------------------------------------------------
# Document Source
# -----------------------------------------------------------------------------
# Where the ingestion pipeline reads files from. Mutually exclusive:
#   "local"      — reads from LOCAL_DOCUMENTS_PATH (default: documents/)
#   "s3"         — reads from S3_BUCKET_NAME; SQS optionally triggers catch-up
#   "sharepoint" — reads from LOCAL_DOCUMENTS_PATH which is populated by the
#                  separate sharepoint-sync service (see SHAREPOINT_* below)
# Settings validation rejects "s3" without S3_BUCKET_NAME, and rejects
# "sharepoint" without all SHAREPOINT_* fields populated.
DOCUMENT_SOURCE=local                   # "local" | "s3" | "sharepoint"
LOCAL_DOCUMENTS_PATH=documents          # Path for local/sharepoint mode

# -----------------------------------------------------------------------------
# AWS (only used when DOCUMENT_SOURCE=s3)
# -----------------------------------------------------------------------------
# Credentials: set explicitly here, or leave empty to use the default
# boto3 credential chain (~/.aws/credentials, IAM role, etc.).
#
# Endpoint URL: set for LocalStack (http://localhost:4566) or other
# S3-compatible services (MinIO, R2, etc.). Leave empty for real AWS.
AWS_ACCESS_KEY_ID=                      # AWS access key (or use ~/.aws/credentials)
AWS_SECRET_ACCESS_KEY=                  # AWS secret key
AWS_REGION=us-east-1                    # AWS region for S3/SQS
AWS_ENDPOINT_URL=                       # e.g. http://localhost:4566 for LocalStack
S3_BUCKET_NAME=                         # e.g. my-documents-bucket
S3_PREFIX=                              # optional key prefix to restrict the scan
# CocoIndex v1 has no built-in S3 push trigger. The queue below is used purely
# as a *trigger*: on an event the daemon debounces, then runs one catch-up
# scan. Nothing is downloaded except objects that actually changed. Leave empty
# to fall back to interval-only sweeps.
S3_SQS_QUEUE_URL=                       # e.g. https://sqs.us-east-1.amazonaws.com/123456789/my-queue
S3_SQS_DEBOUNCE_SECONDS=5               # coalesce an event burst into one run
S3_FULL_SCAN_INTERVAL_HOURS=24          # safety net sweep for missed events

# -----------------------------------------------------------------------------
# SharePoint (only used when DOCUMENT_SOURCE=sharepoint)
# -----------------------------------------------------------------------------
# See docs/ingestion/sharepoint-setup.md for the full walkthrough.
# All six fields below are required when DOCUMENT_SOURCE=sharepoint.
SHAREPOINT_TENANT_ID=                   # Azure AD directory (tenant) id
SHAREPOINT_CLIENT_ID=                   # Azure AD app (client) id
SHAREPOINT_CLIENT_SECRET=               # Client secret value (shown only once on creation)
SHAREPOINT_SITE_ID=                     # e.g. contoso.sharepoint.com,abc-1234,def-5678
SHAREPOINT_DRIVE_ID=                    # The document library's drive id
SHAREPOINT_ROOT_FOLDER_PATH=            # In-scope folder, e.g. /Engineering/Specs
SHAREPOINT_LOCAL_SUBDIR=sharepoint      # Subdir under LOCAL_DOCUMENTS_PATH
SHAREPOINT_SYNC_INTERVAL_SECONDS=180    # Polling interval
SHAREPOINT_STATE_DIR=state/sharepoint   # Where the delta token + index live

# -----------------------------------------------------------------------------
# LLM (Entity Extraction + Agent)
# -----------------------------------------------------------------------------
# Used for entity extraction during ingestion and by the Pydantic AI agent.
# API type options: anthropic, openai (or any OpenAI-compatible via LLM_BASE_URL)
#
# When LLM_BASE_URL is set, the agent routes through an OpenAI-compatible
# endpoint (OpenRouter, Ollama, vLLM, LiteLLM, etc.). LLM_API_TYPE still
# controls client selection for ingestion/VLM; LLM_MODEL is sent as-is.
LLM_API_TYPE=anthropic                  # "anthropic" or "openai"
LLM_MODEL=claude-sonnet-4-20250514     # Model ID for chosen provider
LLM_API_KEY=                            # [REQUIRED] API key for the LLM provider
LLM_BASE_URL=                           # [OPTIONAL] Custom base URL (OpenRouter, Ollama, vLLM, etc.)

# -----------------------------------------------------------------------------
# MCP Server
# -----------------------------------------------------------------------------
# Transport, bind address, port, and URL path for the MCP server that
# exposes search tools to agents.
#
# Transports:
#   http            streamable-http (modern default, recommended). Request/
#                   response per call; clean disconnects; supported by Claude
#                   Code, Claude Desktop, Pydantic AI, and most 2025+ clients.
#   sse             legacy long-lived SSE. Only use if a client requires it.
#                   Emits noisy (but harmless) ClosedResourceError tracebacks
#                   on client disconnect — an upstream FastMCP/MCP-SDK quirk.
#   stdio           subprocess transport; host/port/path are ignored.
MCP_TRANSPORT=http                      # "http" (recommended), "sse", or "stdio"
MCP_HOST=0.0.0.0                        # Bind address; 0.0.0.0 for Docker/LAN, 127.0.0.1 for local-only
MCP_PORT=8080                           # Port for http/sse transports
MCP_PATH=/mcp                           # URL path for http/sse transports (endpoint: http://HOST:PORT+PATH)

# Bearer token auth for MCP tool calls. Leave empty to disable auth.
MCP_API_KEY=                            # [OPTIONAL] Set to secure the MCP server
MCP_PUBLIC_DOMAIN=                      # [PROD ONLY] Public domain for Traefik routing (e.g. mcp.example.com)

# -----------------------------------------------------------------------------
# Live Ingestion (Path B)
# -----------------------------------------------------------------------------
# INGEST_API_KEY gates /session/start; returns ephemeral per-session token
# for /ingest/transcript and /session/end. Leave empty to disable auth.
INGEST_API_KEY=                         # [OPTIONAL] Set to secure live ingest

# -----------------------------------------------------------------------------
# Resilience
# -----------------------------------------------------------------------------
PIPELINE_TIMEOUT=3600                   # Per-file processing timeout in seconds (default 1h)
PIPELINE_MAX_RETRIES=3                  # Failures per file before poison-pill (logs CRITICAL + swallows)
PIPELINE_MAX_CONCURRENT_FILES=4         # Files processed in parallel (CocoIndex max_inflight_components)
GRAPHITI_CONCURRENCY=3                  # Max concurrent Graphiti episode ingestions per page
EXTRACTION_TIMEOUT=30                   # Seconds before LLM extraction times out
TOOL_TIMEOUT=30                         # Seconds before MCP tool calls time out
MAX_RETRIES=3                           # Retry count for transient failures

# -----------------------------------------------------------------------------
# Image Embedding
# -----------------------------------------------------------------------------
# Controls which PDF pages get image-embedded (expensive vision model calls).
# "smart" uses Docling layout analysis to only embed pages with figures/tables/formulas.
# "all" embeds every page (slow). "none" skips image embedding entirely.
IMAGE_EMBED_STRATEGY=smart              # "smart" (default), "all", or "none"
IMAGE_EMBED_MAX_PX=400                  # Max px on longest side before embedding

# -----------------------------------------------------------------------------
# Feature Flags
# -----------------------------------------------------------------------------
RERANK_ENABLED=true                     # Enable cross-encoder reranking (big precision win, ~20ms)
VLM_GENERATION_ENABLED=false            # Enable vision-language model generation
MULTIVEC_ENABLED=false                  # ColBERT multi-vectors (needs jina-colbert-v2)
GRAPH_ENABLED=true                      # Neo4j knowledge graph via Graphiti (slow, LLM-heavy)
GRAPH_SEMAPHORE_LIMIT=10                # Concurrent LLM calls in Graphiti (default: 10)
GRAPH_EPISODE_TARGET_SIZE=1500          # Target chars per Graphiti episode (groups small chunks)
GRAPH_ENGINE=graphiti                   # "graphiti" (LLM, slow, rich) or "gliner" (local CPU, fast)

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO                          # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json                         # "json" (structured) or "text" (human-readable)

# Distributed tracing (Logfire / OpenTelemetry). Default is local-only:
# spans emitted in-process but not shipped anywhere. Set LOGFIRE_TOKEN +
# OBSERVABILITY_LOCAL_ONLY=false to ship to Logfire Cloud.
LOGFIRE_TOKEN=                          # [OPTIONAL] Logfire Cloud token
OBSERVABILITY_LOCAL_ONLY=true           # "true" = no network egress
SERVICE_NAME=spektr                     # Service name tag on all spans

# =============================================================================
# Production Overrides (docker-compose.prod.yml)
# =============================================================================
# In production, services resolve each other by container name on the internal
# Docker network. Override these in your .env.prod (gitignored):
#
#   QDRANT_URL=http://qdrant:6333
#   NEO4J_URI=bolt://neo4j:7687
#   MCP_API_KEY=<generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))">
#   MCP_PUBLIC_DOMAIN=mcp.example.com
#   INGEST_API_KEY=<generate similarly>
#
# Use a strong, randomly generated password for NEO4J_PASSWORD.
# See docs/deployment/production.md for the full setup guide.
